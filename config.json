/*/
    By default, this config is broken and will not work, you will need to enter your own API key along with insert your UniverseIDs,
    once done, delete these comments from the file and it should work
/*/

{
    "MAX_CONCURRENT_UPLOADS": 10,
    "X-API-KEY": "YOUR_API_KEY_HERE",
    "RBXL-BINARY": "RBXM.rbxl",

    // ExcludePlaces is the placeIDs that you do NOT want to be updated by this tool.
    "UNIVERSE-IDS": [ { "UniverseID": 1234567890, "ExcludePlaces": [12345678]} ]
}